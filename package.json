{
  "name": "honeycomb-collateral-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Daily cron agent that detects newly Funded Honeycomb Credit campaigns, generates SEO-optimized case studies via Claude, and publishes them to the Honeycomb Credit website via the Wix CMS.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "check-campaigns": "tsc && node dist/index.js",
    "rebuild": "tsc && node dist/rebuild.js",
    "backfill": "tsc && node dist/backfill.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "typescript": "^5.5.4"
  }
}
