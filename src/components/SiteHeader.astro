---
// Site-wide header. Plain wordmark — no logo asset is bundled in v4 so we
// fall back to typographic treatment using the Raleway display face. Replace
// the wordmark span with an <Image> when an official asset is committed.
---
<header class="border-b border-honeycomb-ink/10 bg-honeycomb-cream/70 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 no-underline">
      <span class="inline-block h-6 w-6 rounded-sm bg-honeycomb-yellow"></span>
      <span class="font-display font-bold text-lg tracking-wide uppercase">
        Honeycomb Credit
      </span>
    </a>
    <nav class="text-sm font-semibold uppercase tracking-wider">
      <a href="https://invest.honeycombcredit.com" class="text-honeycomb-ink no-underline hover:text-honeycomb-purple">
        Browse campaigns
      </a>
    </nav>
  </div>
</header>
