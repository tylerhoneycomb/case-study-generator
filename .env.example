# Copy to .env and fill in to run the agent CLIs locally.
# In CI, every name below is supplied as a GitHub Actions repository secret.

# ---------------------------------------------------------------------------
# Required for generation — scripts/generate.ts, redraft.ts, backfill.ts,
# detect.ts (and anything else that reaches runPipeline()).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Required for discovery and name resolution — scripts/detect.ts and
# scripts/resolve.ts, both of which query PostHog's Fivetran-mirrored
# postgres.campaigns table.
#   POSTHOG_API_KEY    — personal API key with project:query:read
#   POSTHOG_PROJECT_ID — numeric project ID (Honeycomb Credit Production)
# ---------------------------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. Defaults to https://us.posthog.com. Set for EU cloud or self-host.
POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Optional. Local-only: token used by scripts/lib/github.ts when running
# scripts outside CI (issue comments, labels). In CI, GITHUB_TOKEN is
# provided automatically by Actions.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Optional overrides.
#   CASE_STUDY_MODEL     — override the generation model. Defaults to
#                          claude-opus-4-7. Keep PRICING in
#                          scripts/lib/claude.ts in sync with any change.
#   FUNDED_BOT_IDENTITY  — set to 1 to commit as the agent identity rather
#                          than your own git config. Set by the workflows.
#   FUNDED_REPO          — owner/repo fallback when GITHUB_REPOSITORY is unset.
# ---------------------------------------------------------------------------
CASE_STUDY_MODEL=
FUNDED_BOT_IDENTITY=
FUNDED_REPO=
