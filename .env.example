# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/detect.ts and scripts/resolve.ts (PostHog HogQL
# discovery — Fivetran-mirrored postgres.campaigns). Personal API key needs
# project:query:read. In CI, both are supplied by GitHub Actions secrets.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. Defaults to https://us.posthog.com if unset.
POSTHOG_HOST=
