# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/resolve.ts and scripts/detect.ts (PostHog HogQL query
# for funded-campaign discovery / name resolution). In CI, supplied by the
# GitHub Actions secrets of the same name.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. Override the PostHog host, e.g. for EU Cloud. Defaults to
# https://us.posthog.com.
# POSTHOG_HOST=

# Optional. Override the Claude model used for generation (scripts/lib/claude.ts).
# Defaults to claude-opus-4-7.
# CASE_STUDY_MODEL=

# Optional. Local-only fallback for GITHUB_REPOSITORY (owner/repo), used by
# scripts/lib/github.ts and scripts/lib/git.ts when running outside CI, where
# GITHUB_REPOSITORY is set automatically.
# FUNDED_REPO=
