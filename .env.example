# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/resolve.ts (name -> slug lookup) and scripts/detect.ts
# (the cron entry point). PostHog personal API key with project:query:read,
# and the numeric project ID for Honeycomb Credit Production. In CI these are
# supplied by the POSTHOG_API_KEY / POSTHOG_PROJECT_ID GitHub Actions secrets.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. Defaults to https://us.posthog.com.
POSTHOG_HOST=
