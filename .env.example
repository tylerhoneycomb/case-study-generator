# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts,
# and scripts/detect.ts. In CI, supplied by GitHub Actions secrets.
ANTHROPIC_API_KEY=

# Optional locally (CI provides GITHUB_TOKEN automatically).
# Used by scripts/lib/github.ts when running scripts outside CI.
GITHUB_TOKEN=

# Required for scripts/detect.ts (the daily cron entry point).
# POSTHOG_API_KEY: personal API key with project:query:read scope.
# POSTHOG_PROJECT_ID: numeric project ID (find at posthog.com → Project settings).
# In CI, both are wired up as repo secrets in the Detect workflow.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# Optional: override the PostHog cloud host. Defaults to https://us.posthog.com.
# POSTHOG_HOST=https://eu.posthog.com
