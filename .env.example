# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/detect.ts (the daily cron entry point).
# POSTHOG_API_KEY: personal API key with project:query:read scope.
# POSTHOG_PROJECT_ID: numeric project ID for Honeycomb Credit Production.
# Both are also set as repo secrets for the detect.yml workflow.
# POSTHOG_HOST: optional — defaults to https://us.posthog.com (EU cloud: https://eu.posthog.com).
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_HOST=
