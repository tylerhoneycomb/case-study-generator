# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/resolve.ts and scripts/detect.ts. Personal API key
# with project:query:read, and the numeric project ID for the Honeycomb
# Credit Production PostHog project. In CI, supplied by the same-named
# GitHub Actions secrets.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. PostHog cloud region host, only needed if the project isn't on
# the default US cloud. Defaults to https://us.posthog.com.
# POSTHOG_HOST=

# Optional. <owner>/<repo> override for scripts/lib/github.ts when running
# locally outside CI (GITHUB_REPOSITORY is auto-set there).
# FUNDED_REPO=tylerhoneycomb/case-study-generator

# Optional. Override the Claude model used for generation/redraft. Defaults
# to claude-opus-4-7.
# CASE_STUDY_MODEL=
