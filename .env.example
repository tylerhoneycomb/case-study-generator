# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/detect.ts and scripts/resolve.ts. Personal API key with
# project:query:read, scoped to the Honeycomb Credit Production project.
# In CI, supplied by the POSTHOG_API_KEY / POSTHOG_PROJECT_ID repo secrets.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. Only needed if the PostHog project lives on EU cloud; defaults to
# us.posthog.com.
POSTHOG_HOST=
