# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts,
# and scripts/detect.ts. In CI, supplied by the repo secret of the same name.
ANTHROPIC_API_KEY=

# Optional locally. Token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically by the runner.
GITHUB_TOKEN=

# Required for scripts/detect.ts (PostHog/Fivetran discovery). Also needed by
# any script that calls posthog.ts directly. In CI, supplied by repo secrets.
# POSTHOG_API_KEY: personal API key with project:query:read scope.
# POSTHOG_PROJECT_ID: numeric project ID (e.g. 39093 for Honeycomb Credit Production).
# POSTHOG_HOST defaults to https://us.posthog.com; override only if you point
# at a self-hosted instance.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.posthog.com

# Optional — override the Claude model used for generation.
# Defaults to claude-opus-4-7. Useful for cheaper A/B runs on Sonnet or Haiku.
# See PRICING map in scripts/lib/claude.ts for per-model cost estimates.
# CASE_STUDY_MODEL=claude-opus-4-7
