# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/detect.ts (the daily cron entry point).
# POSTHOG_API_KEY: personal API key with project:query:read permission.
# POSTHOG_PROJECT_ID: numeric project ID for the Honeycomb Credit PostHog project.
# Both are set as repo secrets in CI; not needed for generate/redraft/backfill.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# Optional. Defaults to https://us.posthog.com — only set if using the EU cloud.
# POSTHOG_HOST=
