# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/detect.ts (daily cron — funded-campaign discovery).
# POSTHOG_API_KEY: personal API key with project:query:read scope.
# POSTHOG_PROJECT_ID: numeric project ID (Honeycomb Credit Production).
# Both must also be added as repo secrets under Settings → Secrets → Actions.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. Defaults to https://us.posthog.com. Override if your PostHog
# instance is on the EU cloud or self-hosted.
POSTHOG_HOST=
