# Required for scripts/generate.ts, scripts/redraft.ts, scripts/backfill.ts.
# In CI, this is supplied by the GitHub Actions secret of the same name.
ANTHROPIC_API_KEY=

# Optional. Local-only: token used by scripts/lib/github.ts when running scripts
# outside CI. In CI, GITHUB_TOKEN is provided automatically.
GITHUB_TOKEN=

# Required for scripts/resolve.ts and scripts/detect.ts (PostHog HogQL query
# against the Fivetran-mirrored postgres.campaigns table). Personal API key
# needs project:query:read. In CI, both are supplied by repo secrets.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=

# Optional. Defaults to https://us.posthog.com — only set if the project
# lives on a different PostHog region/host.
POSTHOG_HOST=
